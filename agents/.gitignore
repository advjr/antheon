node_modules/
dist/
.env

# Local prospect data — real company/contact info, not source
brando/app/data/crm/prospects.json

# Local conversation history — real chat transcripts, not source
brando/app/data/conversations/*
!brando/app/data/conversations/.gitkeep

# Generated deliverables — keep the folders, not the drafts
brando/app/output/proposals/*
brando/app/output/outreach/*
brando/app/output/research/*
!brando/app/output/proposals/.gitkeep
!brando/app/output/outreach/.gitkeep
!brando/app/output/research/.gitkeep
